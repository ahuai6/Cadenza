{
  "name": "cadenza",
  "productName": "Cadenza",
  "version": "2.22.0",
  "description": "Cadenza: a personal music library whose songs play with lyrics that move to the music, exportable as lyric videos",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:web": "vite build --mode web",
    "build:app": "vite build --mode app && node scripts/fonts.mjs dist-app/fonts",
    "fonts:previews": "node scripts/font-previews.mjs",
    "build:native": "cargo build --release --manifest-path native/cadenza-audio/Cargo.toml --target x86_64-pc-windows-gnu",
    "test:render": "node tests/render.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:hifi": "cargo build --release --manifest-path native/cadenza-audio/Cargo.toml && node tests/hifi.cjs && node tests/desktop-hifi.cjs",
    "electron": "npm run build:app && electron .",
    "models": "node scripts/models.mjs",
    "test:neural": "node tests/neural.cjs",
    "dist:win": "npm run build:app && npm run build:native && node scripts/models.mjs && electron-builder --win --x64",
    "fonts:coverage": "node scripts/font-coverage.mjs"
  },
  "build": {
    "appId": "app.cadenza.desktop",
    "productName": "Cadenza",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist-app/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cadenza-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cadenza-${version}-portable.${ext}"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "native/cadenza-audio/target/x86_64-pc-windows-gnu/release/cadenza-audio.exe",
        "to": "cadenza-audio.exe"
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.bin"
        ]
      },
      {
        "from": ".",
        "to": "licenses",
        "filter": [
          "LICENSE",
          "NOTICE.md"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "author": "Cadenza",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "music-metadata": "12.3.2",
    "node-taglib-sharp": "6.0.3",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/chiron-goround-tc": "^5.3.1",
    "@fontsource-variable/chiron-sung-hk": "^5.3.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource-variable/noto-serif-devanagari": "5.3.0",
    "@fontsource-variable/noto-serif-hebrew": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.1",
    "@fontsource-variable/noto-serif-kr": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@fontsource-variable/noto-serif-tc": "5.3.1",
    "@fontsource-variable/noto-serif-thai": "5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cactus-classical-serif": "^5.3.1",
    "@fontsource/chocolate-classical-sans": "^5.3.1",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/dotgothic16": "5.3.1",
    "@fontsource/huninn": "^5.3.1",
    "@fontsource/iansui": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/kaisei-decol": "^5.3.1",
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/long-cang": "^5.3.0",
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/yuji-syuku": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "@fontsource/zen-antique": "^5.3.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "@fontsource/zhi-mang-xing": "^5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "0.1.74",
    "budoux": "0.10.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "mediabunny": "1.64.0",
    "mp4box": "2.5.0",
    "opencc-js": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
